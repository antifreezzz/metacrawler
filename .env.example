# Metacrawler Configuration
PORT=8079
DB_PATH=data/metacrawler.db
CRON_SCHEDULE=0 * * * *
CRAWL_DELAY_MIN_MS=2000
CRAWL_DELAY_MAX_MS=4000

# Таймаут запросов к LLM в секундах (локальные МоЕ/тяжелые модели могут думать дольше 45с)
# LLM_TIMEOUT_SECONDS=120

# Лимит символов транскрипта летсплея перед отправкой в LLM (по умолчанию 40000).
# Больше лимита - полнее вердикт блогера, но дольше prefill и дороже на внешних API.
# TRANSCRIPT_MAX_CHARS=40000

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=metacrawler-secret-key-change-me

# Whisper STT (Audio Transcription for YouTube Letsplays)
# При выкатке на VPS укажите адрес проксируемого туннеля:
# WHISPER_URL=http://localhost:8666/v1/audio/transcriptions
WHISPER_URL=
# WHISPER_BINARY_PATH=/usr/local/bin/whisper-cli
# WHISPER_MODEL_PATH=models/ggml-tiny.bin
# Длина одного окна аудио (сек) и число окон (до 3: начало/середина/конец).
# Итоговый бюджет аудио = WHISPER_WINDOW_SECONDS * WHISPER_MAX_WINDOWS.
# WHISPER_WINDOW_SECONDS=60
# WHISPER_MAX_WINDOWS=3
# YOUTUBE_COOKIES_PATH=

# Embeddings Engine (pure Go in-memory vectorizer by default)
EMBEDDING_ENGINE=local
EMBEDDING_MODEL=local

# LLM for review analysis (OpenAI-compatible or local llama.cpp)
# При выкатке на VPS через туннель llmcontrol: http://localhost:8666/v1
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=
LLM_MODEL=auto

